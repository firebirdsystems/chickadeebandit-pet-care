{
  "id": "pet-care",
  "name": "Pet Care",
  "version": "1.1.0",
  "description": "Track pet care activities \u2014 feeding, medication, potty breaks, walks, and anything else you configure. Color-coded urgency shows when each activity is due. One tap to log it.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "pets",
    "feeding",
    "medication",
    "care",
    "reminders"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
  "row_policies": {
    "pets": {
      "kind": "adult_writable"
    },
    "activities": {
      "kind": "adult_writable"
    }
  },
  "nav": {
    "label": "Pet Care"
  },
  "widget": {
    "label": "Pet Care",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "\ud83d\udc3e",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "pets_summary",
      "recent_activity"
    ]
  }
}
