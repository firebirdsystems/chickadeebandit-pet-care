{
  "id": "pet-care",
  "contexts": ["household", "shared_space"],
  "name": "Pet Care",
  "version": "1.2.0",
  "description": "Track pet care activities — feeding, medication, potty breaks, walks, and anything else you configure. Color-coded urgency shows when each activity is due. One tap to log it.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "pets",
    "feeding",
    "medication",
    "care",
    "reminders"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "pets": {"sql": "SELECT * FROM app_pet_care__pets ORDER BY created_at"},
    "activities": {"sql": "SELECT * FROM app_pet_care__activities ORDER BY pet_id, sort_order, created_at"}
  },
  "db_encryption": "off",
    "member_references": {
      "logs": {
        "column": "done_by",
        "on_removed": "keep"
      },
      "sits": {
        "column": "created_by",
        "on_removed": "keep"
      }
    },
  "retention": {
    "logs": {
      "default": 365,
      "timestamp_column": "done_at",
      "override_key": "care_history"
    }
  },
  "delete_cascades": {
    "pets": [
      { "table": "activities", "foreign_key": "pet_id" },
      { "table": "logs", "foreign_key": "pet_id" },
      { "table": "sit_tasks", "foreign_key": "pet_id" }
    ],
    "activities": [
      { "table": "logs", "foreign_key": "activity_id" },
      { "table": "sit_tasks", "foreign_key": "activity_id" }
    ],
    "sits": [
      { "table": "sit_tasks", "foreign_key": "sit_id" }
    ]
  },
  "row_policies": {
    "logs": {
      "kind": "member_writable"
    },
    "pets": {
      "kind": "adult_writable"
    },
    "activities": {
      "kind": "adult_writable"
    },
    "sits": {
      "kind": "adult_writable"
    },
    "sit_tasks": {
      "kind": "adult_writable"
    }
  },
  "db_plaintext_columns": ["archived", "sitter_name", "task_label", "label", "detail", "sort_order", "starts_on", "ends_on"],
  "shareable": {
    "sit": {
      "table": "sits",
      "title_column": "title",
      "columns": [
        { "column": "starts_on", "label": "From", "format": "date" },
        { "column": "ends_on", "label": "Until", "format": "date" },
        { "column": "instructions", "label": "Instructions", "format": "multiline" }
      ],
      "visible_where": { "column": "archived", "values": ["0"] },
      "feed": {
        "label": "Done so far",
        "table": "logs",
        "fk_column": "sit_id",
        "columns": [
          { "column": "task_label", "label": "Task", "role": "heading" },
          { "column": "sitter_name", "label": "By", "role": "detail" },
          { "column": "done_at", "label": "Done", "format": "datetime", "role": "timestamp" }
        ],
        "order_column": "done_at",
        "order": "newest",
        "max_items": 100,
        "empty_text": "Nothing ticked off yet."
      },
      "submit": {
        "layout": { "kind": "checklist", "last_done": "all" },
        "table": "logs",
        "fk_column": "sit_id",
        "fields": [
          { "column": "sitter_name", "label": "Your name", "type": "text", "required": true, "max_length": 60 },
          {
            "column": "activity_id",
            "label": "Task",
            "type": "select",
            "required": true,
            "values_from": {
              "table": "sit_tasks",
              "fk_column": "sit_id",
              "id_column": "activity_id",
              "label_column": "label",
              "detail_column": "detail",
              "copy": { "pet_id": "pet_id", "task_label": "label" }
            }
          }
        ],
        "fixed_values": { "done_by": "sitter" },
        "timestamp_columns": ["done_at"],
        "max_submissions": 1000
      }
    }
  },
  "nav": {
    "label": "Pet Care"
  },
  "widget": {
    "label": "Pet Care",
    "size": "small"
  },
  "publishes": [
    "pet_care.logged"
  ],
  "publish_acls": {
    "pet_care.logged": { "require_role": "member" }
  },
  "glance": {
    "source": {
      "kind": "recurring_due"
    },
    "display": {
      "template": "badge",
      "label": "overdue",
      "severity": "warn"
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🐾",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "pets_summary",
      "recent_activity"
    ]
  },
  "digest": {
    "kind": "recurring_due",
    "activity_table": "activities",
    "activity_label_column": "name",
    "activity_icon_column": "icon",
    "interval_column": "interval_hours",
    "interval_unit": "hours",
    "default_interval": 24,
    "parent": {
      "table": "pets",
      "activity_fk_column": "pet_id",
      "parent_label_column": "name"
    },
    "last_done": {
      "table": "logs",
      "activity_fk_column": "activity_id",
      "timestamp_column": "done_at"
    },
    "filters": [
      {
        "column": "schedule_type",
        "equals": "interval"
      }
    ]
  }
}
