{
  "id": "pet-care",
  "name": "Pet Care",
  "version": "1.0.0",
  "description": "Track pet care activities — feeding, medication, potty breaks, walks, and anything else you configure. Color-coded urgency shows when each activity is due. One tap to log it.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "pets",
    "feeding",
    "medication",
    "care",
    "reminders"
  ],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "row_policies": {
    "app_pet_care__pets": { "kind": "adult_writable" },
    "app_pet_care__activities": { "kind": "adult_writable" }
  },
  "nav": {
    "label": "Pet Care"
  },
  "widget": {
    "label": "Pet Care",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "🐾",
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["pets_summary", "recent_activity"]
  }
}
